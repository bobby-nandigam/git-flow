# =============================================================================
# GitFlow Automator — environment variables
# Copy this file to `.env.local` (local dev) and fill in real values.
# NEVER commit `.env` / `.env.local`. This file must contain placeholders only.
# =============================================================================

# --- Database (Neon Postgres — free, no credit card) --------------------------
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/gitflow?sslmode=require"
# Direct (non-pooled) connection string used by Prisma Migrate.
# (Neon's Vercel integration provides this variable automatically.)
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/gitflow?sslmode=require"

# --- Auth.js / NextAuth -------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-openssl-rand-base64-32"
# Full public base URL of the deployment (no trailing slash).
# Local: http://localhost:3000  |  Prod: https://your-app.vercel.app
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# --- GitHub OAuth App ---------------------------------------------------------
# Create at: https://github.com/settings/developers -> "New OAuth App"
# Authorization callback URL: <AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID="replace-me"
GITHUB_CLIENT_SECRET="replace-me"

# --- GitHub Webhook -----------------------------------------------------------
# Shared secret used to sign & verify webhook deliveries (HMAC SHA-256).
# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET="replace-with-openssl-rand-hex-32"

# --- Internal job worker ------------------------------------------------------
# Bearer token protecting the cron/worker endpoint from public invocation.
# Generate with: openssl rand -hex 32
WORKER_SECRET="replace-with-openssl-rand-hex-32"

# --- Slack (optional, per-repository config also stored in DB) ----------------
# Default fallback Slack Incoming Webhook URL (users can override in-dashboard).
# https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=""

# --- AI triage (optional) — Google Gemini (free tier, no credit card) ---------
# Get a key at: https://aistudio.google.com/app/apikey
AI_PROVIDER="gemini"                 # "gemini" | "groq" | "none"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# --- AI triage (optional) — Groq alternative ----------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# --- App config ---------------------------------------------------------------
# Comma-separated allowlist for the app's own public origin (optional hardening).
APP_PUBLIC_URL="http://localhost:3000"
